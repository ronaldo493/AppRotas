# Copie este arquivo para .env.local e ajuste o ambiente local.
EXPO_PUBLIC_STRAPI_URL=http://localhost:1337/api

# Esta chave será incorporada ao aplicativo nativo. Restrinja-a no
# Google Cloud pelo package/bundle identifier, assinatura e APIs usadas.
GOOGLE_MAPS_API_KEY=

# Habilite somente no desenvolvimento local que realmente utilizar HTTP.
# Builds distribuídos devem manter false e acessar o Strapi por HTTPS.
ALLOW_CLEARTEXT_TRAFFIC=false
