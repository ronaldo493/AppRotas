{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "strict": true,
    "jsx": "react-native"
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "android",
    "data",
    "fixtures",
    "node_modules",
    "trash"
  ]
}
