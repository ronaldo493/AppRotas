{
  "expo": {
    "name": "Suporte Drogal",
    "slug": "AppDrogal",
    "version": "2.0.7",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./src/assets/img/LogoApp2.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/img/LogoApp2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Este aplicativo precisa acessar sua localização para mostrar as lojas próximas a você.",
        "NSCameraUsageDescription": "Este aplicativo precisa acessar sua câmera para ler códigos de barras e QR codes.",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      },
      "bundleIdentifier": "com.ronaldo2024.SuporteDrogal"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.ronaldo2024.SuporteDrogal",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Suporte Drogal acesse a câmera",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer"
    ],
    "web": {},
    "extra": {
      "eas": {
        "projectId": "65b71262-be2b-4089-b712-c13c03acc42e"
      }
    },
    "owner": "ronaldo2024"
  }
}
