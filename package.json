{
  "name": "appdrogal",
  "version": "2.0.12",
  "main": "expo/AppEntry.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:patrimonio": "tsx --test tests/patrimonio-report.test.ts",
    "test:route-execution": "tsx --test tests/execucao-rota.test.ts",
    "test:route-preview": "tsx --test tests/route-preview.test.ts",
    "test:route-replacement": "tsx --test tests/route-replacement.test.ts",
    "test:location": "tsx --test tests/location-snapshot.test.ts",
    "test:resilience": "tsx --test tests/resiliencia-execucao-rota.test.ts",
    "test:auth": "tsx --test tests/forced-password-change.test.ts",
    "test:device-session": "tsx --test tests/device-session.test.ts",
    "test:assistant": "node --test tests/assistant.test.cjs",
    "test:assistant-v2": "tsx --test tests/assistant-orchestrator.test.ts",
    "test:assistant-adoption": "tsx --test tests/assistant-adoption.test.ts",
    "test:admin": "tsx --test tests/admin-dashboard.test.ts tests/admin-active-routes-map.test.ts",
    "test:filiais": "tsx --test tests/filiais-distribuicao.test.ts",
    "test:pontos-offline": "tsx --test tests/pontos-sobrepostos-e-rotas-offline.test.ts",
    "dados": "tsx --tsconfig tools/data-sync/tsconfig.json tools/data-sync/src/cli.ts",
    "dados:backup": "yarn dados backup:completo",
    "dados:comparar-origem": "yarn dados origem:comparar",
    "dados:filiais:comparar-origem": "yarn dados filiais:comparar-origem",
    "dados:filiais:atualizar-origem": "yarn dados filiais:atualizar-origem",
    "dados:contatos:comparar-origem": "yarn dados contatos:comparar-origem",
    "dados:contatos:inserir-ausentes-origem": "yarn dados contatos:inserir-ausentes-origem",
    "dados:contatos:sincronizar-origem": "yarn dados contatos:sincronizar-origem",
    "dados:filiais:exportar": "yarn dados filiais:exportar",
    "dados:filiais:validar": "yarn dados filiais:validar",
    "dados:filiais:comparar": "yarn dados filiais:comparar",
    "dados:pontos:exportar": "yarn dados pontos:exportar",
    "dados:pontos:validar": "yarn dados pontos:validar",
    "dados:pontos:comparar": "yarn dados pontos:comparar",
    "dados:usuarios:validar": "yarn dados usuarios:validar",
    "dados:usuarios:comparar": "yarn dados usuarios:comparar",
    "test:all": "tsx --test tests/admin-active-routes-map.test.ts tests/admin-dashboard.test.ts tests/assistant-adoption.test.ts tests/assistant-orchestrator.test.ts tests/device-session.test.ts tests/execucao-rota.test.ts tests/filiais-distribuicao.test.ts tests/forced-password-change.test.ts tests/location-snapshot.test.ts tests/patrimonio-report.test.ts tests/pontos-sobrepostos-e-rotas-offline.test.ts tests/resiliencia-execucao-rota.test.ts tests/route-preview.test.ts tests/route-replacement.test.ts && node --test tests/assistant.test.cjs",
    "build-android": "npx eas-cli@latest build --platform android --profile preview_android",
    "build-android:preview": "npx eas-cli@latest build --platform android --profile preview_android",
    "build-android:production-apk": "npx eas-cli@latest build --platform android --profile production_apk",
    "build-android:store": "npx eas-cli@latest build --platform android --profile production",
    "start": "npx expo start",
    "start-lan": "npx expo start --lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npx expo start --web",
    "pre-build": "npx expo prebuild",
    "show-dependencies": "./gradlew app:dependencies"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "doctor": {
    "reactNativeDirectoryCheck": {
      "exclude": [
        "@expo/metro-runtime",
        "axios-retry",
        "lodash.debounce"
      ],
      "listUnknownPackages": false
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/drawer": "^7.12.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "jwt-decode": "4.0.0",
    "lodash.debounce": "^4.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "supercluster": "8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.1.10",
    "@types/supercluster": "7.1.3",
    "tsx": "4.20.6",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "expo-constants": "18.0.14"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
