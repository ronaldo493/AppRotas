{
  "name": "appdrogal",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build-android": "npx eas-cli@latest build --platform android --profile preview_android",
    "start": "npx expo start",
    "start-lan": "npx expo start --lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npx expo start --web",
    "pre-build": "npx expo prebuild",
    "show-dependencies": "./gradlew app:dependencies"
  },
  "engines": {
    "node": ">=18"
  },
  "doctor": {
    "reactNativeDirectoryCheck": {
      "exclude": [
        "@expo/metro-runtime",
        "axios-retry",
        "lodash.debounce"
      ],
      "listUnknownPackages": false
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/drawer": "^7.12.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "jwt-decode": "4.0.0",
    "lodash.debounce": "^4.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "supercluster": "8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
